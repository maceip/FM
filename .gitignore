# Production signing material must never be committed (debug keystore is an explicit exception).
config/signing/*.jks
config/signing/*.p12
config/signing/*upload*.keystore
config/signing/*release*.keystore
!config/signing/genesis-debug.keystore

# Gradle
.gradle/
build/
**/build/
gradle-app.setting
.gradletasknamecache

# Android / NDK / native build cache
.cxx/
local.properties
*.apk
*.aab
*.dex
*.ap_
captures/
proguard/

# Kotlin compiler caches
.kotlin/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.fleet/

# OS
.DS_Store
Thumbs.db

# Python virtualenvs (used for litert conversion + scripts)
.venv/
.venv-*/
__pycache__/
*.pyc

# Test / smoke run artifacts
artifacts/
/tmp/
.codex/

# Logs
*.log
hs_err_pid*.log

# Recovered/runtime binary assets. Hydrate from private S3 with
# scripts/runtime-binaries.sh; verify APK model assets with
# scripts/download-models.sh --verify-only and SODA packs with
# scripts/verify-soda-assets.sh. These are not tracked in git because several
# exceed GitHub's 100 MB limit and the byte source must not be a dev laptop.
app/src/main/assets/models/*.tflite
app/src/main/assets/models/tts/
app/src/main/assets/soda/*.zip
app/src/main/jniLibs/arm64-v8a/*.so
# recovered-soda.jar is a Kotlin compile-time dep (small, 3.4 MB) — must be tracked.
# Other *.jar still ignored to keep accidental .aar/.jar drops out.
app/libs/*.jar
!app/libs/recovered-soda.jar

# Misplaced design artifacts at repo root
/stitch_*.zip
