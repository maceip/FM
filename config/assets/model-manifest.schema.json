{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmo.local/schemas/model-manifest.schema.json",
  "type": "object",
  "required": [
    "version",
    "assetRoot",
    "models"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "assetRoot": {
      "const": "app/src/main/assets/models"
    },
    "description": {
      "type": "string"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "filename",
          "delivery",
          "sha256",
          "sizeBytes",
          "mediaType",
          "required"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "filename": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "bundled",
              "remote"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
