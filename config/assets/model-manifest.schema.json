{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "assetRoot", "models"],
  "properties": {
    "version": { "const": 1 },
    "modelVersion": { "type": "string" },
    "assetRoot": { "const": "app/src/main/assets/models" },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "filename", "url", "sha256", "sizeBytes", "required"],
        "properties": {
          "id": { "type": "string" },
          "filename": { "type": "string" },
          "url": { "type": "string", "pattern": "^s3://" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "required": { "type": "boolean" },
          "localPath": { "type": "string" },
          "extractTo": { "type": "string" }
        }
      }
    }
  }
}
