      "license_category": "first_party",
      "product_use": "allowed",
      "priority": "critical",
      "status": "manual_collection",
      "notes": "Use for hard-to-find heads, real device acoustics, Buds/watch/glasses/local-peer capture, and gold eval. Every clip must include consent, speaker/device metadata, split assignment, labeler id, and label review state."
